# REGEX: нестандартные разделители
300 r"Объём\s*[-–—:/]\s*(?:ГБ|GB|GiB|МБ|MB|ТБ|TB)" | Warning | "Единица измерения отделена нестандартным разделителем"
301 r"Объем\s*[-–—:/]\s*(?:ГБ|GB|GiB|МБ|MB|ТБ|TB)" | Warning | "Единица измерения отделена нестандартным разделителем"
302 r"Объём\s*[,;]\s*(?:ГБ|GB|GiB|МБ|MB|ТБ|TB)" | Warning | "Использован нестандартный разделитель между названием и единицей измерения"
