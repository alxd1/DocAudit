# ============================================================
# 6. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

r"Данные"                                | Good
r"Диск\s+(для\s+|с\s+)?данными"           | Good
r"Диск\s+данных"                         | Good
r"Data\s+(Disk|Volume)"                  | Good
r"Data\s+Storage\s+(Disk|Volume)"        | Good

r"(Рабочие|Пользовательские|Прикладные)\s+данные" | Normal | "Рекомендуется использовать 'Данные'"
r"Данные\s+приложений"                    | Normal | "Рекомендуется использовать 'Данные'"
r"Data[_-]Disk"                          | Normal | "Рекомендуется использовать пробел"

r"(Даные|Даннные)"                       | Warning | "Опечатка в слове 'Данные'"
r"(Datta|Dtaa|Dataa)"                    | Warning | "Опечатка в слове 'Data'"
