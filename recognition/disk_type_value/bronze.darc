# ============================================================
# 10. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные варианты
r"Bronze"                                | Good
r"Bronze\s+(Tier|Class|Storage|Disk)"     | Good
r"Bronze\s+(Storage|Disk)\s+(Tier|Class)" | Good
r"Bronze\s+Performance(\s+Tier)?"        | Good

# Допустимые варианты
r"(Class|Tier|Storage|Disk)\s+Bronze"     | Normal | "Рекомендуется указывать только 'Bronze'"
r"(Класс|Тип|Диск|Уровень)\s+Bronze"      | Normal | "Рекомендуется указывать только 'Bronze'"
r"Bronze[_-](Tier|Class|Storage)"         | Normal | "Рекомендуется указывать только 'Bronze'"
r"Bronze\s*\((Class|Tier|Storage)\)"     | Normal | "Рекомендуется указывать только 'Bronze'"
r"Bronze\s*[:.;,]"                       | Normal | "Рекомендуется убрать знак препинания"

# Распространённые опечатки
r"Br[o0]nze"                             | Warning | "Возможная замена буквы 'o' цифрой '0'"
r"Bronz[e3]"                             | Warning | "Проверьте последнюю букву в слове 'Bronze'"
r"Br[o0]nz[e3]"                          | Warning | "Проверьте написание класса 'Bronze'"
r"Br[o0]{2,}nze"                         | Warning | "Лишние символы в слове 'Bronze'"
r"Bron+ze"                               | Warning | "Проверьте количество букв 'n'"
r"Bronz+e"                               | Warning | "Проверьте количество букв 'z'"
r"Bronze{2,}"                            | Warning | "Лишние буквы 'e' в слове 'Bronze'"
r"(Bronse|Bronce|Bronxe|Bronde)"          | Warning | "Опечатка в названии Bronze"
r"(Brone|Broze|Bonze|Brnze)"             | Warning | "Пропущена буква в названии Bronze"
r"(8ronze|Br0nze|Bronz3|Br0nz3)"         | Warning | "Использованы цифры вместо букв"

# Недопустимые комбинации
r"Bronze\s*[/+]\s*(Gold|Silver|SSD)"     | Fatal | "Указано несколько классов или типов диска"
r"Bronze\s+(or|или)\s+(Gold|Silver|SSD)" | Fatal | "Необходимо указать одно значение"
