
[<value>]

# ============================================================
# 1. КОРРЕКТНЫЕ ЗНАЧЕНИЯ
# ============================================================

# Целое положительное число без единицы измерения.
# Единица определяется заголовком "Объём (ГБ)".
r"(?P<value>[1-9]\d*)" | Good

# Объём в гигабайтах.
r"(?P<value>[1-9]\d*)\s*(ГБ|GB|Гбайт|Гигабайт|Гигабайтов)" | Good

# ============================================================
# 2. ДОПУСТИМЫЕ ВАРИАНТЫ
# ============================================================

# Дробные значения.
r"(?P<value>(?:[1-9]\d*|0)[.,]\d*[1-9]\d*)" | Normal | "Рекомендуется проверить необходимость дробного объёма диска"
r"(?P<value>(?:[1-9]\d*|0)[.,]\d*[1-9]\d*)\s*(ГБ|GB)" | Normal | "Рекомендуется использовать целое количество ГБ"

# Двоичные единицы измерения.
r"(?P<value>[1-9]\d*)\s*(GiB|ГиБ)" | Normal | "Указаны гибибайты, а не гигабайты. Проверьте единицы измерения"

# Другие единицы измерения.
r"(?P<value>[1-9]\d*)\s*(МБ|MB|MiB)" | Normal | "Указаны мегабайты. Рекомендуется использовать ГБ"
r"(?P<value>[1-9]\d*)\s*(ТБ|TB|TiB)" | Normal | "Указаны терабайты. Рекомендуется использовать ГБ"

# Название характеристики перед числом.
r"Объ[её]м\s*[:=]\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"
r"Размер\s*[:=]\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"
r"Disk\s+Size\s*[:=]\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"

# Назначение единицы перед значением.
r"(ГБ|GB)\s*[:=]\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется записывать единицу измерения после числа"

# ============================================================
# 3. ОШИБКИ ОФОРМЛЕНИЯ
# ============================================================

# Ведущие нули.
r"0+(?P<value>[1-9]\d*)" | Warning | "Рекомендуется убрать ведущие нули"
r"0+(?P<value>[1-9]\d*)\s*(ГБ|GB|Гбайт|Гигабайт)" | Warning | "Рекомендуется убрать ведущие нули"

# Плюс перед значением.
r"\+(?P<value>[1-9]\d*)" | Warning | "Рекомендуется убрать знак '+'"
r"\+(?P<value>[1-9]\d*)\s*(ГБ|GB)" | Warning | "Рекомендуется убрать знак '+'"

# Лишние знаки препинания.
r"(?P<value>[1-9]\d*)\s*(ГБ|GB)\." | Warning | "Рекомендуется убрать точку после единицы измерения"
r"(?P<value>[1-9]\d*)\s*(ГБ|GB):" | Warning | "Рекомендуется убрать двоеточие"
r"(?P<value>[1-9]\d*)\s*(ГБ|GB);" | Warning | "Рекомендуется убрать точку с запятой"
r"(?P<value>[1-9]\d*)\s*(ГБ|GB)\s*\*" | Warning | "Рекомендуется убрать лишний символ"

# Ошибки в обозначениях.
r"(?P<value>[1-9]\d*)\s*ГББ" | Warning | "Лишняя буква в обозначении 'ГБ'"
r"(?P<value>[1-9]\d*)\s*GBB" | Warning | "Лишняя буква в обозначении 'GB'"
r"(?P<value>[1-9]\d*)\s*ГБайт" | Warning | "Рекомендуется использовать 'ГБ'"
r"(?P<value>[1-9]\d*)\s*GGB" | Warning | "Лишняя буква в обозначении 'GB'"

# ============================================================
# 4. НЕДОПУСТИМЫЕ ЗНАЧЕНИЯ
# ============================================================

# Нулевой объём диска.
"0" | Fatal | "Объём виртуального диска должен быть больше нуля"
r"0\s*(ГБ|GB|GiB|ГиБ|МБ|MB|ТБ|TB)" | Fatal | "Объём виртуального диска должен быть больше нуля"

# Отрицательные значения.
r"(?P<value>-\d+)" | Fatal | "Объём виртуального диска не может быть отрицательным"
r"(?P<value>-\d+)\s*(ГБ|GB|GiB|ГиБ|МБ|MB|ТБ|TB)" | Fatal | "Объём виртуального диска не может быть отрицательным"

# Неправильные единицы измерения.
r"(?P<value>\d+)\s*(кг|м|Вт|ГГц|GHz|CPU|vCPU|Core)" | Fatal | "Некорректная единица измерения объёма диска"

# Некорректная десятичная запись.
r"(?P<value>\d+[.,])" | Fatal | "После десятичного разделителя отсутствует дробная часть"
r"(?P<value>[.,]\d+)" | Fatal | "Отсутствует целая часть числа"

# ============================================================
# 5. НЕОДНОЗНАЧНЫЕ ЧИСЛОВЫЕ ЗАПИСИ
# ============================================================

# Указано несколько объёмов вместо одного.
r"\d+\s*[/+]\s*\d+" | Fatal | "Указано несколько значений вместо одного объёма диска"
r"\d+\s*-\s*\d+" | Fatal | "Указан диапазон вместо одного объёма диска"

# Составная конфигурация.
r"\d+\s*[xх×]\s*\d+\s*(ГБ|GB)?" | Fatal | "Указана конфигурация нескольких дисков вместо объёма одного"

# ============================================================
# 6. ДОПОЛНИТЕЛЬНЫЕ ОПЕЧАТКИ
# ============================================================

r"(?P<value>[1-9]\d*)\s*Gigabite[s]?" | Warning | "Рекомендуется использовать обозначение 'GB'"
r"(?P<value>[1-9]\d*)\s*Gigabyt" | Warning | "Опечатка в слове 'Gigabyte'"
r"(?P<value>[1-9]\d*)\s*Гигабайтт" | Warning | "Лишняя буква в слове 'Гигабайт'"
r"(?P<value>[1-9]\d*)\s*Гигабйат" | Warning | "Опечатка в слове 'Гигабайт'"
