# ============================================================
# 11. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные варианты
r"CPU"                                         | Good
r"CPU\s*\(\s*Core\s*,\s*vCore\s*\)"            | Good
r"CPU\s*\(\s*Core\s*/\s*vCore\s*\)"            | Good
r"CPU\s*\(\s*(Core|vCore|vCPU)\s*\)"            | Good
r"CPU\s+(Cores|Count|Core\s+Count)"            | Good
r"v(CPU|Core)s?"                               | Good
r"(VM|Virtual\s+Machine)\s+CPU"                | Good
r"(Virtual\s+CPU|Virtual\s+Processor)\s+Count" | Good

# Допустимые русскоязычные варианты
r"(Количество|Число)\s+(CPU|vCPU|vCore)"       | Good
r"(Количество|Число)\s+(процессоров|ядер|процессорных\s+ядер)" | Normal | "Рекомендуется уточнить тип процессорных ресурсов"
r"Кол-во\s+(CPU|vCPU|vCore|ядер|процессоров)"  | Normal | "Рекомендуется использовать полное слово 'Количество'"
r"(Ядра|Процессоры)\s+(ВМ|сервера)"            | Normal | "Рекомендуется использовать 'CPU'"
r"CPU\s+(ВМ|сервера|виртуальной\s+машины)"     | Good
r"CPU\s*\(\s*кол-во\s+ядер\s*\)"              | Normal | "Рекомендуется использовать 'CPU (Core, vCore)'"

# Допустимые англоязычные варианты
r"(Number\s+of|Count\s+of)\s+(CPU|CPUs|Cores|vCPUs|vCores)" | Normal | "Рекомендуется использовать 'CPU Count'"
r"(CPU|Processor)\s+(Quantity|Number|Count)"  | Normal | "Рекомендуется использовать 'CPU Count'"
r"(VM|Virtual\s+Machine)\s+(vCPU|CPU|CPU\s+Cores)" | Good
r"CPU[_-](Core|Cores|Count)"                   | Normal | "Рекомендуется использовать пробел"
r"CPU\s*\(\s*(Cores|vCores|vCPUs)\s*\)"       | Good

# Форматирование
r"CPU\s*[:.]"                                 | Normal | "Рекомендуется убрать знак препинания"
r"CPU\s*\(\s*Core\s*[,;/]\s*vCore\s*\)"      | Normal | "Рекомендуется использовать 'CPU (Core, vCore)'"

# Опечатки
r"Процес+ор"                                  | Warning | "Проверьте написание слова 'Процессор'"
r"Колличество\s+(CPU|ядер|процессоров)"       | Warning | "Опечатка в слове 'Количество'"
r"CPU\s+Co(r|er|re)"                          | Warning | "Опечатка в слове 'Core'"
r"CPU\s+Conut"                                | Warning | "Опечатка в слове 'Count'"
r"vC(ore|roe|oure)"                           | Warning | "Проверьте написание 'vCore'"





# Резервное распознавание CPU
r".*\bCPU\b.*" | Warning | "Обнаружено обозначение CPU, но заголовок имеет нестандартный формат"
r".*\bvCPU\b.*" | Warning | "Обнаружено обозначение vCPU, но заголовок имеет нестандартный формат"
r".*\bvCore\b.*" | Warning | "Обнаружено обозначение vCore, но заголовок имеет нестандартный формат"
r".*\bпроцессор\b.*" | Warning | "Обнаружено слово 'Процессор', но заголовок имеет нестандартный формат"
r".*\bпроцессоры\b.*" | Warning | "Обнаружено слово 'Процессоры', но заголовок имеет нестандартный формат"
r".*\bпроцессорные\s+ядра\b.*" | Warning | "Обнаружено словосочетание 'Процессорные ядра', но заголовок имеет нестандартный формат"
r".*\bprocessor\b.*" | Warning | "Обнаружено обозначение Processor, но заголовок имеет нестандартный формат"

# Посторонние символы между словами
r".*\bпроцессорные\s*[^\w\s]+\s*ядра\b.*" | Fatal | "Посторонние символы между словами 'Процессорные' и 'ядра'"
