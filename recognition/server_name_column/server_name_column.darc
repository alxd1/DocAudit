# ============================================================
# 11. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные формы
r"Имя\s+сервера"                      | Good
r"Server\s+Name"                      | Good

# Допустимые формы
r"(Название|Наименование)\s+сервера"  | Normal | "Рекомендуется использовать 'Имя сервера'"
r"Имя\s+(ВМ|VM)"                     | Normal | "Рекомендуется использовать 'Имя сервера'"
r"(Имя|Название|Наименование)\s+виртуальной\s+машины" | Normal | "Рекомендуется использовать 'Имя сервера'"
r"(Имя|Название|Наименование)\s+виртуального\s+сервера" | Normal | "Рекомендуется использовать 'Имя сервера'"
r"(Имя|Название|Наименование)\s+(узла|хоста)" | Normal | "Рекомендуется использовать 'Имя сервера'"
r"Server[_-]Name"                    | Normal | "Рекомендуется использовать пробел"
r"Имя[_-]сервера"                     | Normal | "Рекомендуется использовать пробел"
r"(VM|Virtual\s+Machine)\s+Name"     | Normal | "Рекомендуется использовать 'Server Name'"
r"(Host|Machine|Node)\s+Name"        | Normal | "Рекомендуется использовать 'Server Name'"
r"Имя\s+сервера\s*[:.]"              | Normal | "Рекомендуется убрать знак препинания"

# Распространённые опечатки
r"Имя\s+сервера{2,}"                  | Warning | "Лишние буквы в конце слова 'сервера'"
r"Имя\s+севера"                       | Warning | "Опечатка в слове 'сервера'"
r"Имя\s+сервара"                      | Warning | "Опечатка в слове 'сервера'"
r"Serv(er|verr)\s+Nmae"              | Warning | "Опечатка в названии Server Name"
