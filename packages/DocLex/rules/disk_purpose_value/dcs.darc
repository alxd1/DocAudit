
[DCS]

# ============================================================
# 1. КОРРЕКТНЫЕ НАЗВАНИЯ
# ============================================================

10 "DCS"                                 | Good
10 "DCS Disk"                            | Good
10 "DCS Volume"                          | Good
10 "DCS Storage"                         | Good
10 "DCS Data"                            | Good
10 "DCS Partition"                       | Good
10 "Диск DCS"                            | Good
10 "Диск для DCS"                        | Good
10 "Том DCS"                             | Good
10 "Хранилище DCS"                       | Good
10 "Данные DCS"                          | Good
10 "Раздел DCS"                          | Good

# ============================================================
# 2. ДОПУСТИМЫЕ НАЗВАНИЯ
# ============================================================

20 "DCS Drive"                           | Normal | "Рекомендуется использовать 'DCS'"
20 "DCS Virtual Disk"                    | Normal | "Рекомендуется использовать 'DCS'"
20 "DCS Data Disk"                       | Normal | "Рекомендуется использовать 'DCS'"
20 "DCS Data Volume"                     | Normal | "Рекомендуется использовать 'DCS'"
20 "DCS Storage Disk"                    | Normal | "Рекомендуется использовать 'DCS'"
20 "DCS Files"                           | Normal | "Рекомендуется использовать 'DCS'"
20 "DCS File Storage"                    | Normal | "Рекомендуется использовать 'DCS'"
20 "Виртуальный диск DCS"                | Normal | "Рекомендуется использовать 'DCS'"
20 "Диск под DCS"                        | Normal | "Рекомендуется использовать 'DCS'"
20 "Диск с данными DCS"                  | Normal | "Рекомендуется использовать 'DCS'"
20 "Хранилище данных DCS"                | Normal | "Рекомендуется использовать 'DCS'"
20 "Раздел для DCS"                      | Normal | "Рекомендуется использовать 'DCS'"
20 "Том для DCS"                         | Normal | "Рекомендуется использовать 'DCS'"

# ============================================================
# 3. НЕСТАНДАРТНОЕ ФОРМАТИРОВАНИЕ
# ============================================================

30 "DCS:"                                | Normal | "Рекомендуется убрать двоеточие"
30 "DCS."                                | Normal | "Рекомендуется убрать точку"
30 "DCS;"                                | Normal | "Рекомендуется убрать точку с запятой"
30 "DCS-Disk"                            | Normal | "Рекомендуется использовать 'DCS'"
30 "DCS_Disk"                            | Normal | "Рекомендуется использовать 'DCS'"
30 "DCS-Volume"                          | Normal | "Рекомендуется использовать 'DCS'"
30 "DCS_Volume"                          | Normal | "Рекомендуется использовать 'DCS'"
30 "DCS-Storage"                         | Normal | "Рекомендуется использовать 'DCS'"
30 "DCS_Storage"                         | Normal | "Рекомендуется использовать 'DCS'"
30 "DCS-Data"                            | Normal | "Рекомендуется использовать 'DCS'"
30 "DCS_Data"                            | Normal | "Рекомендуется использовать 'DCS'"
30 "D.C.S."                              | Normal | "Рекомендуется использовать написание 'DCS' без точек"

# ============================================================
# 4. СОКРАЩЕНИЯ И ТРАНСЛИТЕРАЦИЯ
# ============================================================

40 "ДЦС"                                 | Normal | "Рекомендуется использовать латинское 'DCS'"
40 "ДКС"                                 | Normal | "Рекомендуется использовать латинское 'DCS'"
40 "ДиСиЭс"                              | Normal | "Рекомендуется использовать латинское 'DCS'"
40 "Диск ДЦС"                            | Normal | "Рекомендуется использовать латинское 'DCS'"
40 "Диск ДКС"                            | Normal | "Рекомендуется использовать латинское 'DCS'"

# ============================================================
# 5. ОПЕЧАТКИ И СМЕШЕНИЕ АЛФАВИТОВ
# ============================================================

50 "DСС"                                 | Warning | "Кириллические буквы вместо латинских 'CS'"
50 "DСS"                                 | Warning | "Кириллическая 'С' вместо латинской 'C'"
50 "DCС"                                 | Warning | "Кириллическая 'С' вместо латинской 'S'"
50 "DSC"                                 | Warning | "Перепутан порядок букв"
50 "DCSC"                                | Warning | "Лишняя буква 'C'"
50 "DCSS"                                | Warning | "Лишняя буква 'S'"
50 "DDCS"                                | Warning | "Лишняя буква 'D'"
50 "DCSs"                                | Warning | "Лишняя буква 's'"
50 "DCS Diskk"                           | Warning | "Возможная опечатка в названии диска"

# ============================================================
# 6. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

60 r"DCS[\s_-]+(?:Disk|Volume|Storage|Data|Partition|Drive)" | Normal | "Рекомендуется использовать 'DCS'"
60 r"DCS[\s_-]+(?:Virtual[\s_-]+Disk|Data[\s_-]+Disk|Data[\s_-]+Volume)" | Normal | "Рекомендуется использовать 'DCS'"
60 r"DCS\s*[:.;]"                         | Normal | "Рекомендуется убрать знак препинания"
60 r"D[\s._-]*C[\s._-]*S"                 | Normal | "Рекомендуется использовать написание 'DCS'"
60 r"(?:Диск|Том|Раздел|Хранилище)\s+(?:для\s+|под\s+)?DCS" | Normal | "Рекомендуется использовать 'DCS'"
60 r"(?:Диск|Том|Хранилище)\s+(?:с\s+)?данными\s+DCS" | Normal | "Рекомендуется использовать 'DCS'"
60 r"(?:DСS|DСС|DCС)[\s_-]+(?:Disk|Volume|Storage|Data)" | Warning | "Обнаружено смешение кириллицы и латиницы"
60 r"(?:DSC|DCSC|DCSS|DDCS)[\s_-]+(?:Disk|Volume|Storage)" | Warning | "Возможная опечатка в обозначении 'DCS'"
