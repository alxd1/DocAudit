# ============================================================
# 8. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные варианты
r"Назначение"                               | Good
r"Назначение\s+(виртуального\s+)?диска"      | Good
r"Назначение\s+(виртуальных\s+)?дисков"      | Good
r"(Virtual\s+)?Disk\s+Purpose"              | Good
r"VM\s+Disk\s+Purpose"                     | Good

# Допустимые варианты
r"(Роль|Функция|Использование)\s+(виртуального\s+)?диска" | Normal | "Рекомендуется использовать 'Назначение'"
r"Цель\s+использования\s+(виртуального\s+)?диска" | Normal | "Рекомендуется использовать 'Назначение'"
r"(Virtual\s+)?Disk\s+(Role|Usage)"         | Normal | "Рекомендуется использовать 'Disk Purpose'"
r"Назн\.\s*(виртуального\s+)?диска"         | Normal | "Рекомендуется использовать полное название"

# Форматирование
r"Назначение\s*[:.]"                       | Normal | "Рекомендуется убрать знак препинания"
r"Назначение[_-]диска"                      | Normal | "Рекомендуется использовать пробел"
r"Disk[_-]Purpose"                         | Normal | "Рекомендуется использовать пробел"

# Опечатки
r"Назначен+ие"                             | Warning | "Проверьте написание слова 'Назначение'"
r"Назночение\s+(виртуального\s+)?диска"    | Warning | "Опечатка в слове 'Назначение'"
r"Disk\s+Porpose"                          | Warning | "Опечатка в слове 'Purpose'"
