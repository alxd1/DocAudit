[<value>]

# ============================================================
# 1. КОРРЕКТНЫЕ ЗНАЧЕНИЯ
# ============================================================

# Положительное целое число.
# Количество ядер определяется заголовком CPU (Core, vCore).
r"(?P<value>[1-9]\d*)" | Good

# Число с указанием единицы измерения.
r"(?P<value>[1-9]\d*)\s*(CPU|vCPU|vCore)" | Good
r"(?P<value>[1-9]\d*)\s*(Core|Cores)" | Good
r"(?P<value>[1-9]\d*)\s*(vCores|vCPUs)" | Good

# Русскоязычные обозначения.
r"(?P<value>[1-9]\d*)\s+ядро" | Good
r"(?P<value>[1-9]\d*)\s+ядра" | Good
r"(?P<value>[1-9]\d*)\s+ядер" | Good
r"(?P<value>[1-9]\d*)\s+виртуальных?\s+ядер" | Good
r"(?P<value>[1-9]\d*)\s+виртуальных?\s+процессоров" | Good

# ============================================================
# 2. ДОПУСТИМЫЕ ВАРИАНТЫ
# ============================================================

# Название характеристики перед числом.
r"CPU\s*[:=]\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"
r"vCPU\s*[:=]\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"
r"vCore\s*[:=]\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"

r"CPU\s+(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"
r"vCPU\s+(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"
r"vCore\s+(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"

# Русскоязычные варианты.
r"Количество\s+(CPU|vCPU|vCore)\s*[:=]?\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"
r"Количество\s+ядер\s*[:=]?\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"
r"Число\s+ядер\s*[:=]?\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только число"

# Сокращения.
r"(?P<value>[1-9]\d*)\s*шт\.?" | Normal | "Рекомендуется не указывать 'шт.' для количества ядер"
r"(?P<value>[1-9]\d*)\s*ед\.?" | Normal | "Рекомендуется указывать только число"
r"(?P<value>[1-9]\d*)\s*ядер\." | Normal | "Рекомендуется убрать точку"

# ============================================================
# 3. ОШИБКИ ФОРМАТИРОВАНИЯ
# ============================================================

# Ведущие нули.
r"0+(?P<value>[1-9]\d*)" | Warning | "Рекомендуется убрать ведущие нули"
r"0+(?P<value>[1-9]\d*)\s*(CPU|vCPU|vCore|Core|Cores)" | Warning | "Рекомендуется убрать ведущие нули"

# Избыточные символы.
r"\+(?P<value>[1-9]\d*)" | Warning | "Рекомендуется убрать знак '+'"
r"\+(?P<value>[1-9]\d*)\s*(CPU|vCPU|vCore)" | Warning | "Рекомендуется убрать знак '+'"

r"(?P<value>[1-9]\d*)\s*(CPU|vCPU|vCore)\." | Warning | "Рекомендуется убрать точку после обозначения"
r"(?P<value>[1-9]\d*)\s*(CPU|vCPU|vCore):" | Warning | "Рекомендуется убрать двоеточие"
r"(?P<value>[1-9]\d*)\s*(CPU|vCPU|vCore)\s*\*" | Warning | "Рекомендуется убрать лишний символ"

# Опечатки в обозначениях.
r"(?P<value>[1-9]\d*)\s*CPUU" | Warning | "Лишняя буква 'U' в обозначении CPU"
r"(?P<value>[1-9]\d*)\s*vCPUU" | Warning | "Лишняя буква 'U' в обозначении vCPU"
r"(?P<value>[1-9]\d*)\s*vCor" | Warning | "Пропущена буква 'e' в обозначении vCore"
r"(?P<value>[1-9]\d*)\s*Coer" | Warning | "Опечатка в слове 'Core'"
r"(?P<value>[1-9]\d*)\s*ядраа" | Warning | "Лишняя буква 'а' в слове 'ядра'"
r"(?P<value>[1-9]\d*)\s*ядр" | Warning | "Некорректная форма слова 'ядро'"

# ============================================================
# 4. НЕДОПУСТИМЫЕ ЗНАЧЕНИЯ
# ============================================================

# Нулевое количество ядер.
"0" | Fatal | "Количество ядер CPU должно быть больше нуля"
r"0\s*(CPU|vCPU|vCore|Core|Cores)" | Fatal | "Количество ядер CPU должно быть больше нуля"
r"0\s*(ядро|ядра|ядер)" | Fatal | "Количество ядер CPU должно быть больше нуля"

# Отрицательное количество.
r"(?P<value>-\d+)" | Fatal | "Количество ядер CPU не может быть отрицательным"
r"(?P<value>-\d+)\s*(CPU|vCPU|vCore|Core|Cores)" | Fatal | "Количество ядер CPU не может быть отрицательным"

# Дробные количества ядер.
r"(?P<value>\d+[.,]\d+)" | Fatal | "Количество процессорных ядер должно быть целым числом"
r"(?P<value>\d+[.,]\d+)\s*(CPU|vCPU|vCore|Core|Cores)" | Fatal | "Количество процессорных ядер должно быть целым числом"

# Некорректная десятичная запись.
r"(?P<value>\d+[.,])" | Fatal | "После десятичного разделителя отсутствует дробная часть"
r"(?P<value>[.,]\d+)" | Fatal | "Отсутствует целая часть числа"

# Недопустимые единицы измерения.
r"(?P<value>\d+)\s*(ГБ|GB|МБ|MB|ГГц|GHz|Вт)" | Fatal | "Некорректная единица измерения количества ядер CPU"

# ============================================================
# 5. НЕОДНОЗНАЧНЫЕ ЗАПИСИ
# ============================================================

# Такие записи нельзя однозначно трактовать как количество ядер.
r"\d+\s*[/+]\s*\d+" | Fatal | "Указано несколько чисел вместо одного количества ядер"
r"\d+\s*[xх×]\s*\d+" | Fatal | "Указана составная конфигурация CPU. Требуется уточнить общее количество ядер"
r"\d+\s*-\s*\d+" | Fatal | "Указан диапазон вместо одного количества ядер"

# ============================================================
# 6. ПРОЧИЕ ОПЕЧАТКИ
# ============================================================

r"(?P<value>[1-9]\d*)\s*corre" | Warning | "Опечатка в слове 'Core'"
r"(?P<value>[1-9]\d*)\s*coress" | Warning | "Опечатка в слове 'Cores'"
r"(?P<value>[1-9]\d*)\s*vCroe" | Warning | "Опечатка в обозначении 'vCore'"
r"(?P<value>[1-9]\d*)\s*vCP" | Warning | "Неполное обозначение 'vCPU'"
