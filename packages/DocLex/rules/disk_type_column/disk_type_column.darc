706 r"(?:\w+\s+){1,2}Disk Type" | Warning | "Перед английским названием типа диска присутствуют дополнительные слова"
707 r"Disk Type(?:\s+\w+){1,2}" | Warning | "После английского названия типа диска присутствуют дополнительные слова"
708 r"(?:\w+\s+){1,2}Disk Class" | Warning | "Перед английским названием класса диска присутствуют дополнительные слова"
709 r"Disk Class(?:\s+\w+){1,2}" | Warning | "После английского названия класса диска присутствуют дополнительные слова"
