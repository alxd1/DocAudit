# ============================================================
# 13. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные варианты
r"Тип\s*\(\s*производительность\s*\)"       | Good
r"Тип\s+(виртуального\s+)?диска\s*\(\s*производительность\s*\)" | Good
r"Класс\s+производительности(\s+(виртуального\s+)?диска)?" | Good
r"(Disk|Storage)\s+Performance\s+(Class|Tier|Level)" | Good
r"(Virtual\s+Disk|VM\s+Disk)\s+Performance\s+Class" | Good
r"(Disk|Storage)\s+Tier"                     | Good

# Допустимые русскоязычные варианты
r"Тип\s+(виртуального\s+)?диска"            | Normal | "Рекомендуется использовать 'Тип (производительность)'"
r"(Класс|Категория|Уровень)\s+(виртуального\s+)?диска" | Normal | "Рекомендуется использовать 'Класс производительности диска'"
r"(Тип|Класс)\s+дисков"                     | Normal | "Рекомендуется использовать 'Тип (производительность)'"
r"(Класс|Категория|Уровень)\s+производительности" | Normal | "Рекомендуется уточнить, что речь идёт о дисках"
r"Тип\s*\(\s*произв\.?\s*\)"               | Normal | "Рекомендуется использовать полное слово 'производительность'"

# Допустимые англоязычные варианты
r"(Disk|Storage)\s+(Type|Class|Category)"    | Normal | "Рекомендуется использовать 'Disk Performance Class'"
r"(VM|Virtual\s+Disk)\s+(Type|Class|Tier)"  | Normal | "Рекомендуется использовать 'Disk Performance Class'"
r"(Performance)\s+(Class|Tier|Category)"    | Normal | "Рекомендуется уточнить, что речь идёт о дисках"
r"(Disk|Storage)[_-](Performance|Class|Tier)" | Normal | "Рекомендуется использовать пробелы"

# Названия с перечислением допустимых значений
r"Тип\s*\(\s*Gold\s*[/,;]\s*Silver\s*[/,;]\s*Bronze\s*[/,;]\s*SSD\s*\)" | Good
r"Класс\s*\(\s*Gold\s*[/,;]\s*Silver\s*[/,;]\s*Bronze\s*[/,;]\s*SSD\s*\)" | Good
r"(Disk\s+Type|Disk\s+Class)\s*\(\s*Gold\s*[/,;]\s*Silver\s*[/,;]\s*Bronze\s*[/,;]\s*SSD\s*\)" | Good

# Опечатки
r"Тип\s*\(\s*производител[ьл]?ность\s*\)"  | Warning | "Проверьте написание слова 'производительность'"
r"Тип\s*\(\s*производительнос[т]?ь\s*\)"  | Warning | "Проверьте написание слова 'производительность'"
r"Disk\s+Perfomance\s+(Class|Tier)"         | Warning | "Опечатка в слове 'Performance'"
r"Disk\s+Performence\s+(Class|Tier)"        | Warning | "Опечатка в слове 'Performance'"





# Резервное распознавание типа виртуального диска
r".*\bтип\b.*" | Warning | "Обнаружено слово 'Тип', но заголовок имеет нестандартный формат"
r".*\bкласс\s+производительности\b.*" | Warning | "Обнаружено словосочетание 'Класс производительности', но заголовок имеет нестандартный формат"
r".*\bпроизводительность\s+диска\b.*" | Warning | "Обнаружено словосочетание 'Производительность диска', но заголовок имеет нестандартный формат"
r".*\bdisk\s+type\b.*" | Warning | "Обнаружено обозначение Disk Type, но заголовок имеет нестандартный формат"
r".*\bdisk\s+tier\b.*" | Warning | "Обнаружено обозначение Disk Tier, но заголовок имеет нестандартный формат"
r".*\bdisk\s+performance\b.*" | Warning | "Обнаружено обозначение Disk Performance, но заголовок имеет нестандартный формат"

# Посторонние символы между словами
r".*\bкласс\s*[^\w\s]+\s*производительности\b.*" | Fatal | "Посторонние символы между словами 'Класс' и 'производительности'"
r".*\bdisk\s*[^\w\s]+\s*type\b.*" | Fatal | "Посторонние символы между словами 'Disk' и 'Type'"
