607 r"Storage\s+\w+\s+Tier" | Warning | "Между английскими словами присутствует дополнительное слово"

# REGEX: дополнительные слова перед или после полного названия
700 r"(?:\w+\s+){1,2}Тип диска" | Warning | "Перед названием типа диска присутствуют дополнительные слова"
701 r"Тип диска(?:\s+\w+){1,2}" | Warning | "После названия типа диска присутствуют дополнительные слова"
702 r"(?:\w+\s+){1,2}Тип дисков" | Warning | "Перед названием типа дисков присутствуют дополнительные слова"
703 r"Тип дисков(?:\s+\w+){1,2}" | Warning | "После названия типа дисков присутствуют дополнительные слова"
