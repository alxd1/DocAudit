# ============================================================
# 13. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные варианты
r"Объ[её]м\s*\(\s*ГБ\s*\)"                  | Good
r"Объ[её]м\s+диска\s*\(\s*ГБ\s*\)"          | Good
r"Объ[её]м\s+виртуального\s+диска\s*\(\s*ГБ\s*\)" | Good
r"Размер\s*\(\s*ГБ\s*\)"                   | Good
r"Размер\s+(виртуального\s+)?диска\s*\(\s*ГБ\s*\)" | Good
r"(Disk|Virtual\s+Disk|VM\s+Disk)\s+Size\s*\(\s*GB\s*\)" | Good
r"Disk\s+Capacity\s*\(\s*GB\s*\)"          | Good

# Допустимые русскоязычные варианты
r"Объ[её]м"                                | Normal | "Рекомендуется указывать единицу измерения"
r"Объ[её]м\s+(виртуального\s+)?диска"        | Normal | "Рекомендуется указывать единицу измерения"
r"(Размер|Ёмкость|Емкость)\s+(виртуального\s+)?диска" | Normal | "Рекомендуется использовать 'Объём (ГБ)'"
r"(Объ[её]м|Размер)\s+(диска|дисков)\s+(ВМ|сервера)" | Normal | "Рекомендуется указывать единицу измерения"
r"(Объ[её]м|Размер)\s*\(\s*(МБ|MB|MiB|ТБ|TB|TiB)\s*\)" | Normal | "Потребуется преобразование единиц измерения"

# Допустимые англоязычные варианты
r"(Disk|Virtual\s+Disk|VM\s+Disk)\s+(Size|Capacity)" | Normal | "Рекомендуется указывать единицу измерения"
r"(Disk|Volume)\s+(Size|Capacity)\s*\(\s*(GB|GiB)\s*\)" | Good
r"(Disk|Volume)\s+(Size|Capacity)\s*\(\s*(MB|MiB|TB|TiB)\s*\)" | Normal | "Потребуется преобразование единиц измерения"
r"(Disk|Volume)[_-](Size|Capacity)"           | Normal | "Рекомендуется использовать пробел"

# Форматирование
r"Объ[её]м\s*[:.]"                          | Normal | "Рекомендуется убрать знак препинания"
r"Объ[её]м\s*[-:/]\s*ГБ"                    | Normal | "Рекомендуется использовать скобки"
r"Объ[её]м\s*\[\s*ГБ\s*\]"                 | Normal | "Рекомендуется использовать круглые скобки"
r"Disk[_-]Size[_-]GB"                        | Normal | "Рекомендуется использовать 'Disk Size (GB)'"

# Опечатки
r"Объ[её]мм?\s*\(\s*ГБ\s*\)"                | Warning | "Проверьте написание слова 'Объём'"
r"Об[её]м\s*\(\s*ГБ\s*\)"                   | Warning | "Пропущен твёрдый знак в слове 'Объём'"
