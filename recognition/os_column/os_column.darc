# ============================================================
# 12. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные формы
r"Операционная\s+система"                 | Good
r"Операционная\s+система\s+сервера"       | Good
r"Операционная\s+система\s+ВМ"            | Good
r"ОС"                                    | Good
r"Operating\s+System"                     | Good
r"Server\s+Operating\s+System"            | Good
r"VM\s+Operating\s+System"                | Good

# Допустимые формы
r"(Название|Наименование|Тип)\s+ОС"        | Normal | "Рекомендуется использовать 'Операционная система'"
r"ОС\s+(сервера|ВМ|виртуальной\s+машины)"  | Normal | "Рекомендуется использовать 'Операционная система'"
r"(Название|Наименование)\s+операционной\s+системы" | Normal | "Рекомендуется использовать 'Операционная система'"
r"Операционная\s+система\s+и\s+ПО"        | Good
r"ОС\s+и\s+ПО"                           | Good
r"ОС\s*[/+]\s*ПО"                        | Normal | "Рекомендуется использовать 'ОС и ПО'"
r"ОС\s*[,;]\s*ПО"                        | Normal | "Рекомендуется использовать 'ОС и ПО'"
r"ОС\s+и\s+(дополнительное|прикладное|установленное)\s+ПО" | Normal | "Рекомендуется использовать 'ОС и ПО'"

r"(OS|Operating\s+System)\s+(Name|Type|Version)" | Normal | "Рекомендуется использовать 'Operating System'"
r"(Server|VM|Guest)\s+OS"                 | Normal | "Рекомендуется использовать 'Operating System'"
r"(Installed|Guest)\s+Operating\s+System" | Normal | "Рекомендуется использовать 'Operating System'"
r"Operating[_-]System"                    | Normal | "Рекомендуется использовать пробел"
r"Операционная[_-]система"                 | Normal | "Рекомендуется использовать пробел"
r"Операционная\s+система\s*[:.]"          | Normal | "Рекомендуется убрать знак препинания"
r"ОС\s*[:.]"                              | Normal | "Рекомендуется убрать знак препинания"
r"OS[_-](Name|Version|Type)"               | Normal | "Рекомендуется использовать пробел"
r"OS\s*[/+]\s*Software"                   | Normal | "Рекомендуется использовать 'OS and Software'"

# Распространённые опечатки
r"Операционая\s+система"                  | Warning | "Опечатка в слове 'Операционная'"
r"Операционная\s+систе+ма"                | Warning | "Проверьте написание слова 'Система'"
r"Операционная\s+систма"                  | Warning | "Пропущена буква в слове 'Система'"
r"Операционная\s+ситема"                  | Warning | "Пропущена буква в слове 'Система'"
r"Operat(ing|ig)\s+System"                | Warning | "Проверьте написание слова 'Operating'"
r"Operating\s+Sytem"                      | Warning | "Опечатка в слове 'System'"
r"Operating\s+Systtem"                    | Warning | "Лишняя буква в слове 'System'"


