# ============================================================
# 10. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные варианты
r"Silver"                                | Good
r"Silver\s+(Tier|Class|Storage|Disk)"     | Good
r"Silver\s+(Storage|Disk)\s+(Tier|Class)" | Good
r"Silver\s+Performance(\s+Tier)?"        | Good

# Допустимые варианты
r"(Class|Tier|Storage|Disk)\s+Silver"     | Normal | "Рекомендуется указывать только 'Silver'"
r"(Класс|Тип|Диск|Уровень)\s+Silver"      | Normal | "Рекомендуется указывать только 'Silver'"
r"Silver[_-](Tier|Class|Storage)"         | Normal | "Рекомендуется указывать только 'Silver'"
r"Silver\s*\((Class|Tier|Storage)\)"     | Normal | "Рекомендуется указывать только 'Silver'"
r"Silver\s*[:.;,]"                       | Normal | "Рекомендуется убрать знак препинания"

# Опечатки
r"Sil+ver"                               | Warning | "Проверьте количество букв 'l'"
r"Silv+er"                               | Warning | "Проверьте количество букв 'v'"
r"Silve+r"                               | Warning | "Проверьте количество букв 'e'"
r"Silver{2,}"                            | Warning | "Лишние буквы 'r' в названии класса"
r"(Sliver|Sivler|Silvre|Silevr)"          | Warning | "Неправильный порядок букв в названии Silver"
r"(S1lver|Si1ver|5ilver|Silv3r)"          | Warning | "Использованы цифры вместо букв"

# Недопустимые комбинации
r"Silver\s*[/+]\s*(Gold|Bronze|SSD)"     | Fatal | "Указано несколько классов или типов диска"
r"Silver\s+(or|или)\s+(Gold|Bronze|SSD)" | Fatal | "Необходимо указать одно значение"
