[РК]

# ============================================================
# 1. КОРРЕКТНЫЕ НАЗВАНИЯ
# ============================================================

10 "РК"                                    | Good
20 "РК Disk"                               | Good
20 "РК Volume"                             | Good
20 "Диск РК"                               | Good
20 "Диск для РК"                           | Good
20 "Том РК"                                | Good
20 "Назначение РК"                         | Good

# ============================================================
# 2. ДОПУСТИМЫЕ НАЗВАНИЯ
# ============================================================

30 "РК Storage"                            | Normal | "Рекомендуется использовать 'РК'"
30 "РК Data"                               | Normal | "Рекомендуется использовать 'РК'"
30 "РК Virtual Disk"                       | Normal | "Рекомендуется использовать 'РК'"
30 "Виртуальный диск РК"                   | Normal | "Рекомендуется использовать 'РК'"
30 "Диск под РК"                           | Normal | "Рекомендуется использовать 'РК'"
30 "Хранилище РК"                          | Normal | "Рекомендуется использовать 'РК'"

# ============================================================
# 3. НЕСТАНДАРТНОЕ ФОРМАТИРОВАНИЕ
# ============================================================

40 "РК:"                                   | Normal | "Рекомендуется убрать двоеточие"
40 "РК."                                   | Normal | "Рекомендуется убрать точку"
40 "РК;"                                   | Normal | "Рекомендуется убрать точку с запятой"
40 "РК-Disk"                               | Normal | "Рекомендуется использовать 'РК'"
40 "РК_Disk"                               | Normal | "Рекомендуется использовать 'РК'"

# ============================================================
# 4. ОПЕЧАТКИ И СМЕШЕНИЕ АЛФАВИТОВ
# ============================================================

50 "PK"                                    | Warning | "Использованы латинские буквы вместо кириллических 'РК'"
50 "PК"                                    | Warning | "Латинская 'P' вместо кириллической 'Р'"
50 "РK"                                    | Warning | "Латинская 'K' вместо кириллической 'К'"
50 "РКК"                                   | Warning | "Лишняя буква 'К'"
50 "РРК"                                   | Warning | "Лишняя буква 'Р'"
50 "КР"                                    | Warning | "Перепутан порядок букв"
50 "PK Disk"                               | Warning | "Использованы латинские буквы вместо кириллических 'РК'"

# ============================================================
# 5. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

60 r"РК\s*[:.;]"                           | Normal | "Рекомендуется убрать знак препинания"
60 r"РК[\s_-]+(?:Disk|Volume)"              | Normal | "Нестандартное разделение слов"
60 r"(?:PK|PК|РK)\s+(?:Disk|Volume)"         | Warning | "Использованы латинские буквы вместо кириллических 'РК'"