# ============================================================
# 10. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные варианты
r"SSD"                                      | Good
r"SSD\s+(Disk|Drive|Storage)"               | Good
r"Solid[-\s]+State\s+(Drive|Disk)"          | Good

# Допустимые варианты
r"SSD\s+(Tier|Class|Performance)"           | Normal | "Рекомендуется использовать только 'SSD'"
r"SSD\s+(Storage|Disk)\s+(Tier|Class)"      | Normal | "Рекомендуется использовать только 'SSD'"
r"(Class|Tier|Storage|Disk\s+Type)\s+SSD"   | Normal | "Рекомендуется использовать только 'SSD'"
r"(Диск|Тип|Класс|Хранилище)\s+SSD"          | Normal | "Рекомендуется использовать только 'SSD'"
r"SSD[_-](Disk|Drive|Storage)"              | Normal | "Рекомендуется использовать только 'SSD'"
r"SSD\s*\((Class|Tier|Storage)\)"           | Normal | "Рекомендуется использовать только 'SSD'"
r"SSD\s*[:.;,]"                             | Normal | "Рекомендуется убрать знак препинания"

# Опечатки
r"S{3,}D"                                  | Warning | "Лишние буквы 'S'"
r"S{2}D{2,}"                               | Warning | "Лишние буквы 'D'"
r"(SDD|SDS|S5D|5SD|SS0)"                   | Warning | "Проверьте написание 'SSD'"
r"Solid\s+Sate\s+Drive"                   | Warning | "Опечатка в слове 'State'"

# Недопустимые комбинации
r"SSD\s*[/+]\s*(Gold|Silver|Bronze)"        | Fatal | "Указано несколько типов или классов диска"
r"SSD\s+(or|или)\s+(Gold|Silver|Bronze)"   | Fatal | "Необходимо указать одно значение"
