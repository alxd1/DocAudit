# ============================================================
# 12. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные формы
r"Дисковая\s+подсистема"                  | Good
r"Подсистема\s+дисков"                    | Good
r"Disk\s+Subsystem"                       | Good
r"(Server|VM|Virtual\s+Disk)\s+Disk\s+Subsystem" | Good

# Допустимые варианты
r"Диски\s+(сервера|ВМ|виртуальной\s+машины)" | Normal | "Рекомендуется использовать 'Дисковая подсистема'"
r"(Конфигурация|Параметры|Характеристики)\s+дисков" | Normal | "Рекомендуется использовать 'Дисковая подсистема'"
r"(Список|Перечень)\s+дисков"             | Normal | "Рекомендуется использовать 'Дисковая подсистема'"
r"Дисковая[_-]подсистема"                  | Normal | "Рекомендуется использовать пробел"
r"Дисковая\s+подсистема\s*[:.]"           | Normal | "Рекомендуется убрать знак препинания"
r"(VM|Server)\s+Disks"                    | Normal | "Рекомендуется использовать 'Disk Subsystem'"
r"Disk[_-](Configuration|Subsystem)"       | Normal | "Рекомендуется использовать пробел"
r"Virtual\s+Disk\s+Configuration"         | Normal | "Рекомендуется использовать 'Disk Subsystem'"

# Заголовки с перечислением характеристик
r"Диски\s*\(\s*назначение\s*,\s*(объём|объем|размер)\s*,\s*тип\s*\)" | Normal | "Рекомендуется использовать 'Дисковая подсистема'"
r"Дисковая\s+подсистема\s*\(\s*назначение\s*,\s*(объём|объем|размер)\s*,\s*тип\s*\)" | Normal | "Рекомендуется убрать перечисление подстолбцов"

# Опечатки
r"Дисковая\s+подсистемма"                 | Warning | "Лишняя буква 'м' в слове 'подсистема'"
r"Дисковая\s+подистема"                   | Warning | "Пропущена буква в слове 'подсистема'"
r"Диск[ао]вая\s+подсистема"               | Warning | "Возможная опечатка в слове 'Дисковая'"
r"Disk\s+Subsytem"                        | Warning | "Опечатка в слове 'Subsystem'"
r"Disk\s+Confguration"                    | Warning | "Опечатка в слове 'Configuration'"





# Резервное распознавание дисковой подсистемы
r".*\bдисковая\s+подсистема\b.*" | Warning | "Обнаружено словосочетание 'Дисковая подсистема', но заголовок имеет нестандартный формат"
r".*\bдисковая\s+система\b.*" | Warning | "Обнаружено словосочетание 'Дисковая система', но заголовок имеет нестандартный формат"
r".*\bдисковое\s+пространство\b.*" | Warning | "Обнаружено словосочетание 'Дисковое пространство', но заголовок имеет нестандартный формат"
r".*\bdisk\s+subsystem\b.*" | Warning | "Обнаружено обозначение Disk Subsystem, но заголовок имеет нестандартный формат"
r".*\bstorage\s+subsystem\b.*" | Warning | "Обнаружено обозначение Storage Subsystem, но заголовок имеет нестандартный формат"

# Посторонние символы между словами
r".*\bдисковая\s*[^\w\s]+\s*подсистема\b.*" | Fatal | "Посторонние символы между словами 'Дисковая' и 'подсистема'"
r".*\bdisk\s*[^\w\s]+\s*subsystem\b.*" | Fatal | "Посторонние символы между словами 'Disk' и 'Subsystem'"
