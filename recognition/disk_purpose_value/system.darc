# ============================================================
# 6. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

r"Системный"                             | Good
r"Системный\s+(виртуальный\s+)?диск"      | Good
r"Диск\s+(для\s+|под\s+)?ОС"             | Good
r"(System|OS)\s+(Disk|Volume)"           | Good
r"Operating\s+System\s+Disk"             | Good

r"Сист\.\s*диск"                        | Normal | "Рекомендуется использовать 'Системный'"
r"(Boot|Root)\s+(Disk|Volume)"           | Normal | "Рекомендуется использовать 'Системный'"
r"Системный[_-]диск"                     | Normal | "Рекомендуется использовать пробел"

r"(Системый|Системнный|Ситемный)"         | Warning | "Опечатка в слове 'Системный'"
r"Sytem\s+Disk"                          | Warning | "Опечатка в слове 'System'"
