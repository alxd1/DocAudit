# REGEX: уточнения в скобках
400 r"Назначение\s*\((?:диска|дисков|тома|томов|накопителя|накопителей|виртуального диска)\)" | Normal | "В скобках уточнён объект назначения"
401 r"Назначение диска\s*\((?:сервера|ВМ|виртуальной машины)\)" | Normal | "Уточнена принадлежность диска"
402 r"Назначение дисков\s*\((?:сервера|ВМ|виртуальной машины)\)" | Normal | "Уточнена принадлежность дисков"
403 r"Назначение тома\s*\((?:диска|ВМ|виртуальной машины)\)" | Normal | "Уточнена принадлежность дискового тома"
404 r"Disk Purpose\s*\((?:Server|VM|Virtual Machine)\)" | Normal | "К назначению диска добавлено уточнение объекта"
405 r"Volume Purpose\s*\((?:Disk|VM|Virtual Machine)\)" | Normal | "К назначению тома добавлено уточнение объекта"
406 r"Назначение\s*\([^()]{1,50}\)" | Warning | "К названию добавлено непроверенное уточнение"
407 r"Назначение диска\s*\([^()]{1,50}\)" | Warning | "К названию назначения диска добавлено непроверенное уточнение"
408 r"Disk Purpose\s*\([^()]{1,50}\)" | Warning | "К английскому названию добавлено непроверенное уточнение"

# REGEX: уточнения перед названием
450 r"\((?:диск|диски|том|тома|накопитель)\)\s*Назначение" | Normal | "Перед названием уточнён объект назначения"
451 r"\((?:Disk|Disks|Volume|Drive)\)\s*Purpose" | Normal | "Перед английским названием уточнён объект назначения"
452 r"\([^()]{1,50}\)\s*Назначение" | Warning | "Перед названием присутствует непроверенное уточнение"
453 r"\([^()]{1,50}\)\s*Назначение диска" | Warning | "Перед названием назначения диска присутствует непроверенное уточнение"
454 r"\([^()]{1,50}\)\s*Disk Purpose" | Warning | "Перед английским названием присутствует непроверенное уточнение"

