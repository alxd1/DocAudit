# 5. ОПЕЧАТКИ И СМЕШЕНИЕ АЛФАВИТОВ
# ============================================================

50 "SWAPP"                               | Warning | "Лишняя буква 'P'"
50 "SWPA"                                | Warning | "Перепутан порядок букв"
50 "SAWP"                                | Warning | "Перепутан порядок букв"
50 "SWPА"                                | Warning | "Обнаружено смешение кириллицы и латиницы"
50 "SWАP"                                | Warning | "Кириллическая 'А' вместо латинской 'A'"
50 "SWAР"                                | Warning | "Кириллическая 'Р' вместо латинской 'P'"
50 "SWA"                                 | Warning | "Пропущена буква 'P'"
50 "SVAP"                                | Warning | "Возможная опечатка в слове 'SWAP'"
50 "СВАП"                                | Warning | "Рекомендуется использовать латинское 'SWAP'"
50 "СВОП"                                | Warning | "Рекомендуется использовать латинское 'SWAP'"

# ============================================================
# 6. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

60 r"SWAP[\s_-]+(?:Disk|Partition|Volume|Space|Drive|Storage|Area)" | Normal | "Рекомендуется использовать 'SWAP'"
60 r"SWAP\s*[:.;]"                        | Normal | "Рекомендуется убрать знак препинания"
60 r"SWAP[\s_-]*File"                     | Normal | "Рекомендуется использовать 'SWAP'"
60 r"Linux[\s_-]+SWAP(?:[\s_-]+Partition)?" | Normal | "Рекомендуется использовать 'SWAP'"
60 r"SWP[\s_-]+(?:Disk|Partition|Volume|Space)" | Normal | "Рекомендуется использовать полное название 'SWAP'"
60 r"(?:Диск|Раздел|Том|Файл|Область|Пространство)\s+(?:для\s+|под\s+)?подкачки" | Normal | "Рекомендуется использовать 'SWAP'"
60 r"(?:Своп|Свап)[\s_-]+(?:раздел|файл|диск)" | Normal | "Рекомендуется использовать 'SWAP'"
60 r"(?:SWАP|SWAР|СВАП|СВОП)"            | Warning | "Проверьте написание 'SWAP' и используемый алфавит"
