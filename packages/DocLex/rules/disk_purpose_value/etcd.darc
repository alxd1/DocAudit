
[etcd]

# ============================================================
# 1. КОРРЕКТНЫЕ НАЗВАНИЯ
# ============================================================

"etcd"                                  | Good
"etcd Disk"                             | Good
"etcd Volume"                           | Good
"etcd Storage"                          | Good
"etcd Data"                             | Good
"etcd Data Disk"                        | Good
"etcd Data Volume"                      | Good

"Диск etcd"                             | Good
"Диск для etcd"                         | Good
"Диск данных etcd"                      | Good
"Хранилище etcd"                        | Good
"Том etcd"                              | Good
"Данные etcd"                           | Good

# ============================================================
# 2. ДОПУСТИМЫЕ НАЗВАНИЯ
# ============================================================

"etcd DB"                               | Normal | "Рекомендуется использовать 'etcd'"
"etcd Database"                         | Normal | "Рекомендуется использовать 'etcd'"
"etcd Storage Disk"                     | Normal | "Рекомендуется использовать 'etcd'"
"etcd Persistent Volume"                | Normal | "Рекомендуется использовать 'etcd'"
"etcd PV"                               | Normal | "Рекомендуется использовать 'etcd'"

"Диск под etcd"                         | Normal | "Рекомендуется использовать 'etcd'"
"Диск БД etcd"                          | Normal | "Рекомендуется использовать 'etcd'"
"Постоянное хранилище etcd"             | Normal | "Рекомендуется использовать 'etcd'"
"Диск кластера etcd"                    | Normal | "Рекомендуется использовать 'etcd'"

# ============================================================
# 3. НЕСТАНДАРТНОЕ ФОРМАТИРОВАНИЕ
# ============================================================

"etcd:"                                 | Normal | "Рекомендуется убрать двоеточие"
"etcd."                                 | Normal | "Рекомендуется убрать точку"
"etcd;"                                 | Normal | "Рекомендуется убрать точку с запятой"
"etcd *"                                | Normal | "Рекомендуется убрать лишний символ"
"etcd_disk"                             | Normal | "Рекомендуется использовать 'etcd'"
"etcd-disk"                             | Normal | "Рекомендуется использовать 'etcd'"
"etcd_data"                             | Normal | "Рекомендуется использовать 'etcd'"
"etcd-data"                             | Normal | "Рекомендуется использовать 'etcd'"

# ============================================================
# 4. ОПЕЧАТКИ
# ============================================================

"etccd"                                 | Warning | "Лишняя буква 'c'"
"etdc"                                  | Warning | "Перепутан порядок букв"
"ectd"                                  | Warning | "Неправильный порядок букв"
"etcds"                                 | Warning | "Лишняя буква 's'"
"etcdcd"                                | Warning | "Повторение символов"
"etct"                                  | Warning | "Опечатка в названии etcd"
"etcdt"                                 | Warning | "Лишняя буква 't'"
"etcd Dataa"                            | Warning | "Опечатка в слове 'Data'"

# ============================================================
# 5. НЕОДНОЗНАЧНЫЕ НАЗВАНИЯ
# ============================================================

"Kubernetes Data"                       | Warning | "Не все данные Kubernetes хранятся в etcd"
"K8s Data"                              | Warning | "Уточните, что речь идёт именно о данных etcd"
"Cluster Data"                          | Warning | "Неясно, какие именно данные кластера хранятся"
"Control Plane Data"                    | Warning | "Не обязательно обозначает хранилище etcd"

# ============================================================
# 6. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

r"etcd"                                  | Good
r"etcd\s+(Disk|Volume|Storage|Data)"      | Good
r"etcd\s+Data\s+(Disk|Volume)"            | Good
r"Диск\s+(для\s+|под\s+)?etcd"            | Good
r"(Данные|Хранилище|Том)\s+etcd"          | Good

r"etcd[_-](disk|data)"                   | Normal | "Рекомендуется использовать 'etcd'"
r"etcd\s*[:.;]"                          | Normal | "Рекомендуется убрать знак препинания"

r"(etccd|etdc|ectd|etcds)"               | Warning | "Проверьте написание etcd"
