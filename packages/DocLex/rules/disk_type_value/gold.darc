# ============================================================
# 10. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные варианты
r"Gold"                                  | Good
r"Gold\s+(Tier|Class|Storage|Disk)"        | Good
r"Gold\s+(Storage|Disk)\s+(Tier|Class)"    | Good
r"Gold\s+Performance(\s+Tier)?"           | Good

# Допустимые варианты
r"(Class|Tier|Storage|Disk)\s+Gold"        | Normal | "Рекомендуется указывать только 'Gold'"
r"(Класс|Тип|Диск|Уровень)\s+Gold"         | Normal | "Рекомендуется указывать только 'Gold'"
r"Gold[_-](Tier|Class|Storage)"           | Normal | "Рекомендуется указывать только 'Gold'"
r"Gold\s*\((Class|Tier|Storage)\)"        | Normal | "Рекомендуется указывать только 'Gold'"
r"Gold\s*[:.;,]"                         | Normal | "Рекомендуется убрать знак препинания"

# Распространённые опечатки
r"G[o0]{2,}ld"                           | Warning | "Проверьте количество букв 'o'"
r"G[o0]ld{2,}"                           | Warning | "Лишние символы в названии 'Gold'"
r"G(o|0)(l|I|1)d"                        | Warning | "Проверьте правильность написания 'Gold'"
r"(Goold|Goald|GLOD|GODL)"               | Warning | "Опечатка в названии класса 'Gold'"

# Недопустимые комбинации
r"Gold\s*[/+]\s*(Silver|Bronze|SSD)"      | Fatal | "Указано несколько классов или типов диска"
r"Gold\s+(or|или)\s+(Silver|Bronze|SSD)"  | Fatal | "Необходимо указать одно значение"
