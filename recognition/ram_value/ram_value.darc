[<value>]

# ============================================================
# 1. КОРРЕКТНЫЕ ЗНАЧЕНИЯ
# ============================================================

# Положительное целое число без единицы измерения.
# Единица измерения определяется заголовком столбца RAM (ГБ).
r"(?P<value>[1-9]\d*)" | Good

# Число с указанием гигабайт.
r"(?P<value>[1-9]\d*)\s*(ГБ|GB|Гбайт|Гигабайт)" | Good

# ============================================================
# 2. ДОПУСТИМЫЕ ВАРИАНТЫ
# ============================================================

# Дробные объёмы RAM.
r"(?P<value>[1-9]\d*[.,]\d*[1-9]\d*)" | Normal | "Проверьте необходимость использования дробного значения RAM"
r"(?P<value>[1-9]\d*[.,]\d*[1-9]\d*)\s*(ГБ|GB|Гбайт|Гигабайт)" | Normal | "Рекомендуется использовать целое количество ГБ"

# Двоичные единицы измерения.
# GiB и ГиБ не тождественны десятичным GB и ГБ.
r"(?P<value>[1-9]\d*)\s*(GiB|ГиБ)" | Normal | "Указаны гибибайты. Проверьте единицы измерения в документе"

# Значения с явно указанной характеристикой.
r"RAM\s*[:=]\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только числовое значение"
r"ОЗУ\s*[:=]\s*(?P<value>[1-9]\d*)" | Normal | "Рекомендуется указывать только числовое значение"
r"(?P<value>[1-9]\d*)\s*(ГБ|GB)\s+RAM" | Normal | "Рекомендуется убрать из значения название характеристики"

# ============================================================
# 3. ОШИБКИ ОФОРМЛЕНИЯ
# ============================================================

# Ведущие нули.
r"0+(?P<value>[1-9]\d*)" | Warning | "Рекомендуется убрать ведущие нули"
r"0+(?P<value>[1-9]\d*)\s*(ГБ|GB|Гбайт|Гигабайт)" | Warning | "Рекомендуется убрать ведущие нули"

# Избыточные символы.
r"(?P<value>[1-9]\d*)\s*(ГБ|GB)\." | Warning | "Рекомендуется убрать точку после единицы измерения"
r"(?P<value>[1-9]\d*)\s*(ГБ|GB):" | Warning | "Рекомендуется убрать двоеточие"
r"(?P<value>[1-9]\d*)\s*(ГБ|GB)\s*\*" | Warning | "Рекомендуется убрать лишний символ"
r"\+(?P<value>[1-9]\d*)" | Warning | "Рекомендуется убрать знак '+'"
r"\+(?P<value>[1-9]\d*)\s*(ГБ|GB)" | Warning | "Рекомендуется убрать знак '+'"

# Некорректные единицы измерения.
r"(?P<value>[1-9]\d*)\s*(Gb|Гб)" | Warning | "Проверьте единицу измерения: гигабиты и гигабайты различаются"

# ============================================================
# 4. НЕДОПУСТИМЫЕ ЗНАЧЕНИЯ
# ============================================================

"0" | Fatal | "Объём оперативной памяти должен быть больше нуля"
r"0\s*(ГБ|GB|GiB|ГиБ)" | Fatal | "Объём оперативной памяти должен быть больше нуля"

r"-\d+" | Fatal | "Объём оперативной памяти не может быть отрицательным"
r"-\d+\s*(ГБ|GB|GiB|ГиБ)" | Fatal | "Объём оперативной памяти не может быть отрицательным"

# Число с неправильной единицей измерения.
r"\d+\s*(кг|м|Вт|Hz|GHz)" | Fatal | "Некорректная единица измерения оперативной памяти"

# Некорректные числовые записи.
r"\d+[.,]" | Fatal | "После десятичного разделителя отсутствует дробная часть"
r"[.,]\d+" | Fatal | "Отсутствует целая часть числа"

# ============================================================
# 5. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ ДЛЯ ОПЕЧАТОК
# ============================================================

r"(?P<value>[1-9]\d*)\s*ГББ" | Warning | "Лишняя буква в обозначении 'ГБ'"
r"(?P<value>[1-9]\d*)\s*GBB" | Warning | "Лишняя буква в обозначении 'GB'"
r"(?P<value>[1-9]\d*)\s*ГБайт" | Warning | "Рекомендуется использовать обозначение 'ГБ'"
r"(?P<value>[1-9]\d*)\s*Gigabyte[s]?" | Normal | "Рекомендуется использовать краткое обозначение 'GB'"
