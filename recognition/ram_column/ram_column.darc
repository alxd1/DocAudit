# ============================================================
# 13. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

# Корректные формы
r"RAM"                                               | Good
r"ОЗУ"                                               | Good
r"Оперативная\s+память"                              | Good
r"RAM\s*\(\s*(ГБ|Гбайт|ГиБ|GB|GiB)\s*\)"            | Good
r"ОЗУ\s*\(\s*(ГБ|GB|GiB)\s*\)"                      | Good
r"Оперативная\s+память\s*\(\s*(ГБ|GB|GiB)\s*\)"    | Good
r"RAM\s+(Size|Capacity)"                             | Good
r"Memory\s+(Size|Capacity)"                          | Good

# Допустимые русскоязычные варианты
r"(Объём|Объем|Размер)\s+(ОЗУ|RAM)"                  | Normal | "Рекомендуется использовать 'RAM (ГБ)'"
r"(Объём|Объем|Размер)\s+оперативной\s+памяти"       | Good
r"(Память|ОЗУ|RAM)\s+(ВМ|сервера)"                   | Normal | "Рекомендуется использовать 'RAM (ГБ)'"
r"RAM\s+(ВМ|сервера|виртуальной\s+машины)"           | Good
r"(Опер\.?|Оператив\.)\s*память"                     | Normal | "Рекомендуется использовать полное название"
r"RAM\s*\(\s*(МБ|MB|MiB|ТБ|TB|TiB)\s*\)"            | Normal | "Необходимо учитывать единицы измерения"

# Допустимые англоязычные варианты
r"(VM|Server|Virtual\s+Machine)\s+(RAM|Memory)"      | Good
r"(Allocated|Assigned|Configured)\s+(RAM|Memory)"    | Normal | "Уточните, какой объём памяти указан"
r"(RAM|Memory)\s+(Amount|Quantity|Volume)"          | Normal | "Рекомендуется использовать 'RAM Size'"
r"(RAM|Memory)\s*\(\s*(GB|GiB|MB|MiB|TB|TiB)\s*\)" | Good
r"(RAM|Memory)[_-](Size|Capacity)"                   | Normal | "Рекомендуется использовать пробел"

# Форматирование
r"RAM\s*[:.]"                                        | Normal | "Рекомендуется убрать знак препинания"
r"RAM\s*[-:/]\s*(ГБ|GB|GiB)"                        | Normal | "Рекомендуется использовать скобки"
r"Оперативная[_-]память"                             | Normal | "Рекомендуется использовать пробел"
r"RAM\s*\[\s*(ГБ|GB|GiB)\s*\]"                     | Normal | "Рекомендуется использовать круглые скобки"

# Опечатки
r"R(A|А)(M|М){2,}"                                   | Warning | "Проверьте написание аббревиатуры RAM"
r"Оперативн+ая\s+память"                             | Warning | "Проверьте написание слова 'Оперативная'"
r"Оперативная\s+памя+ть"                             | Warning | "Проверьте написание слова 'Память'"
r"Memm?ory\s+(Sise|Sze)"                             | Warning | "Опечатка в названии Memory Size"
r"RAM\s+(Sise|Sze)"                                  | Warning | "Опечатка в слове 'Size'"
r"RAM\s+(Capasity|Capcity)"                          | Warning | "Опечатка в слове 'Capacity'"
