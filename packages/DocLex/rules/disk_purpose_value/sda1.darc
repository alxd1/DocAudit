
[sda1]

# ============================================================
# 1. КОРРЕКТНЫЕ НАЗВАНИЯ
# ============================================================

10 "sda1"                                | Good
10 "/dev/sda1"                           | Good
10 "Раздел sda1"                         | Good
10 "Диск sda1"                           | Good
10 "Раздел /dev/sda1"                    | Good
10 "Дисковый раздел sda1"                | Good
10 "Partition sda1"                      | Good
10 "sda1 Partition"                      | Good
10 "Device /dev/sda1"                    | Good

# ============================================================
# 2. ДОПУСТИМЫЕ НАЗВАНИЯ
# ============================================================

20 "sda1 Disk"                           | Normal | "Рекомендуется использовать 'sda1'"
20 "sda1 Volume"                         | Normal | "Рекомендуется использовать 'sda1'"
20 "sda1 Storage"                        | Normal | "Рекомендуется использовать 'sda1'"
20 "sda1 Device"                         | Normal | "Рекомендуется использовать 'sda1'"
20 "sda1 Drive"                          | Normal | "Рекомендуется использовать 'sda1'"
20 "Linux sda1"                          | Normal | "Рекомендуется использовать 'sda1'"
20 "Linux Partition sda1"                | Normal | "Рекомендуется использовать 'sda1'"
20 "Том sda1"                            | Normal | "Рекомендуется использовать 'sda1'"
20 "Устройство sda1"                     | Normal | "Рекомендуется использовать 'sda1'"
20 "Раздел диска sda1"                   | Normal | "Рекомендуется использовать 'sda1'"
20 "Диск /dev/sda1"                      | Normal | "Рекомендуется использовать 'sda1'"
20 "Том /dev/sda1"                       | Normal | "Рекомендуется использовать 'sda1'"

# ============================================================
# 3. НЕСТАНДАРТНОЕ ФОРМАТИРОВАНИЕ
# ============================================================

30 "sda1:"                               | Normal | "Рекомендуется убрать двоеточие"
30 "sda1."                               | Normal | "Рекомендуется убрать точку"
30 "sda1;"                               | Normal | "Рекомендуется убрать точку с запятой"
30 "sda-1"                               | Normal | "Рекомендуется использовать 'sda1'"
30 "sda_1"                               | Normal | "Рекомендуется использовать 'sda1'"
30 "sda 1"                               | Normal | "Рекомендуется использовать 'sda1'"
30 "sda/1"                               | Normal | "Рекомендуется использовать 'sda1'"
30 "/dev/sda-1"                          | Normal | "Рекомендуется использовать '/dev/sda1'"
30 "/dev/sda_1"                          | Normal | "Рекомендуется использовать '/dev/sda1'"
30 "/dev/sda 1"                          | Normal | "Рекомендуется использовать '/dev/sda1'"

# ============================================================
# 4. СОКРАЩЕНИЯ И ОПИСАНИЯ
# ============================================================

40 "SDA1"                                | Normal | "Рекомендуется использовать строчное написание 'sda1'"
40 "Sda1"                                | Normal | "Рекомендуется использовать строчное написание 'sda1'"
40 "SDA-1"                               | Normal | "Рекомендуется использовать 'sda1'"
40 "SDA_1"                               | Normal | "Рекомендуется использовать 'sda1'"
40 "Partition 1 on sda"                  | Normal | "Рекомендуется использовать 'sda1'"
40 "Первый раздел sda"                   | Normal | "Рекомендуется использовать 'sda1'"
40 "Раздел №1 диска sda"                 | Normal | "Рекомендуется использовать 'sda1'"

# ============================================================
# 5. ОПЕЧАТКИ И СМЕШЕНИЕ АЛФАВИТОВ
# ============================================================

50 "sdal"                                | Warning | "Латинская 'l' вместо цифры '1'"
50 "sdai"                                | Warning | "Латинская 'i' вместо цифры '1'"
50 "sdaI"                                | Warning | "Латинская 'I' вместо цифры '1'"
50 "sdа1"                                | Warning | "Кириллическая 'а' вместо латинской 'a'"
50 "ѕda1"                                | Warning | "Кириллическая 'ѕ' вместо латинской 's'"
50 "сda1"                                | Warning | "Кириллическая 'с' вместо латинской 's'"
50 "sda11"                               | Warning | "Лишняя цифра '1'"
50 "sdaa1"                               | Warning | "Лишняя буква 'a'"
50 "sdda1"                               | Warning | "Лишняя буква 'd'"
50 "sad1"                                | Warning | "Перепутан порядок букв"
50 "das1"                                | Warning | "Перепутан порядок букв"

# ============================================================
# 6. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

60 r"(?:/dev/)?sda1"                     | Good
60 r"(?:Раздел|Диск|Том|Устройство)\s+(?:/dev/)?sda1" | Good
60 r"(?:Partition|Device)\s+(?:/dev/)?sda1" | Good

60 r"(?:/dev/)?sda[\s_-]+1"              | Normal | "Рекомендуется использовать 'sda1'"
60 r"(?:/dev/)?sda1\s*[:.;]"             | Normal | "Рекомендуется убрать знак препинания"
60 r"(?:Linux\s+)?(?:Partition|Disk|Volume|Storage|Device)\s+(?:/dev/)?sda1" | Normal | "Рекомендуется использовать 'sda1'"

60 r"(?:/dev/)?sda[lIi]"                 | Warning | "Вместо цифры '1' использована похожая буква"
60 r"(?:/dev/)?sdа1"                     | Warning | "Обнаружено смешение кириллицы и латиницы"
60 r"(?:/dev/)?sda11"                    | Warning | "Возможная опечатка в номере раздела"
