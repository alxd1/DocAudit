
[PK]

# ============================================================
# 1. КОРРЕКТНЫЕ НАЗВАНИЯ
# ============================================================

"PK"                                    | Good
"PK Disk"                               | Good
"PK Volume"                             | Good
"Диск PK"                               | Good
"Диск для PK"                           | Good
"Том PK"                                | Good
"Назначение PK"                         | Good

# ============================================================
# 2. ДОПУСТИМЫЕ НАЗВАНИЯ
# ============================================================

"PK Storage"                            | Normal | "Рекомендуется использовать 'PK'"
"PK Data"                               | Normal | "Рекомендуется использовать 'PK'"
"PK Virtual Disk"                       | Normal | "Рекомендуется использовать 'PK'"
"Виртуальный диск PK"                   | Normal | "Рекомендуется использовать 'PK'"
"Диск под PK"                           | Normal | "Рекомендуется использовать 'PK'"
"Хранилище PK"                          | Normal | "Рекомендуется использовать 'PK'"

# ============================================================
# 3. НЕСТАНДАРТНОЕ ФОРМАТИРОВАНИЕ
# ============================================================

"PK:"                                   | Normal | "Рекомендуется убрать двоеточие"
"PK."                                   | Normal | "Рекомендуется убрать точку"
"PK;"                                   | Normal | "Рекомендуется убрать точку с запятой"
"PK *"                                  | Normal | "Рекомендуется убрать лишний символ"
"PK-Disk"                               | Normal | "Рекомендуется использовать 'PK'"
"PK_Disk"                               | Normal | "Рекомендуется использовать 'PK'"

# ============================================================
# 4. ОПЕЧАТКИ И СМЕШЕНИЕ АЛФАВИТОВ
# ============================================================

"РК"                                    | Warning | "Использованы кириллические буквы вместо латинских PK"
"PК"                                    | Warning | "Кириллическая 'К' вместо латинской 'K'"
"РK"                                    | Warning | "Кириллическая 'Р' вместо латинской 'P'"
"PKK"                                   | Warning | "Лишняя буква 'K'"
"PPK"                                   | Warning | "Лишняя буква 'P'"
"KP"                                    | Warning | "Перепутан порядок букв"
"РК Disk"                               | Warning | "Обнаружено смешение алфавитов"

# ============================================================
# 5. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

r"PK"                                    | Good
r"PK\s+(Disk|Volume)"                     | Good
r"Диск\s+(для\s+)?PK"                     | Good

r"PK[_-]Disk"                            | Normal | "Рекомендуется использовать 'PK'"
r"PK\s*[:.;]"                            | Normal | "Рекомендуется убрать знак препинания"

r"(PKK|PPK|KP)"                          | Warning | "Проверьте написание PK"
