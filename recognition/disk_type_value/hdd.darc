# ============================================================

50 "HHD"                                 | Warning | "Перепутан порядок букв"
50 "HDDD"                                | Warning | "Лишняя буква 'D'"
50 "HD"                                  | Warning | "Возможно, пропущена буква 'D'"
50 "HDDDD"                               | Warning | "Лишние буквы 'D'"
50 "HDDd"                                | Warning | "Лишняя буква 'D'"
50 "НDD"                                 | Warning | "Кириллическая 'Н' вместо латинской 'H'"
50 "HДD"                                 | Warning | "Кириллическая 'Д' вместо латинской 'D'"
50 "HDД"                                 | Warning | "Кириллическая 'Д' вместо латинской 'D'"
50 "НДД"                                 | Warning | "Использована кириллица вместо латинского 'HDD'"
50 "НDD Disk"                            | Warning | "Обнаружено смешение кириллицы и латиницы"
50 "Жосткий диск"                        | Warning | "Опечатка в слове 'Жёсткий'"
50 "Жеский диск"                         | Warning | "Пропущена буква 'т'"

# ============================================================
# 6. РЕГУЛЯРНЫЕ ВЫРАЖЕНИЯ
# ============================================================

60 r"HDD[\s_-]+(?:Disk|Drive|Storage|Volume)" | Normal | "Рекомендуется использовать 'HDD'"
60 r"HDD\s*[:.;]"                        | Normal | "Рекомендуется убрать знак препинания"
60 r"H[\s._-]*D[\s._-]*D"                | Normal | "Рекомендуется использовать написание 'HDD'"
60 r"Hard[\s_-]+Disk(?:[\s_-]+Drive)?"   | Normal | "Рекомендуется использовать 'HDD'"
60 r"(?:Magnetic|Mechanical)[\s_-]+(?:Disk|Drive|HDD)" | Normal | "Рекомендуется использовать 'HDD'"
60 r"(?:Диск|Накопитель)\s+HDD"          | Normal | "Рекомендуется использовать 'HDD'"
60 r"(?:Жёсткий|Жесткий)\s+(?:магнитный\s+)?(?:диск|накопитель)" | Normal | "Рекомендуется использовать 'HDD'"
60 r"(?:НDD|HДD|HDД|НДД)"                | Warning | "Обнаружено смешение кириллицы и латиницы"
60 r"(?:HHD|HDDD|HDDDD)"                 | Warning | "Возможная опечатка в обозначении 'HDD'"
