# REGEX: перестановки слов, включая дополнительные слова между компонентами.
# Для многословных формулировок порядок слов свободный (проверка через lookahead).
# Совпадение широких шаблонов является только WARNING: обязательна проверка контекста.

700 r"(?!.*(?:\b(?:cpu|ram|gpu|ip|dns|fqdn|os|vcore|vcpu|hdd|ssd|volume|disk|size|role|type|owner|count|address|location|purpose|operating|system|description)\b|\b(?:роль|тип|адрес|количество|владелец|местоположение|назначение|описание|операционная|диск|диска|дисковая|объ[её]м|память|озу|ядра|ядер|процессор|процессора|размещение)\b))(?=[\s\S]*(?<!\w)Имя(?!\w))(?=[\s\S]*(?<!\w)сервера(?!\w))[\s\S]{0,110}" | Warning | "Перестановка слов или дополнительный текст между ними"
702 r"(?!.*(?:\b(?:cpu|ram|gpu|ip|dns|fqdn|os|vcore|vcpu|hdd|ssd|volume|disk|size|role|type|owner|count|address|location|purpose|operating|system|description)\b|\b(?:роль|тип|адрес|количество|владелец|местоположение|назначение|описание|операционная|диск|диска|дисковая|объ[её]м|память|озу|ядра|ядер|процессор|процессора|размещение)\b))(?=[\s\S]*(?<!\w)Название(?!\w))(?=[\s\S]*(?<!\w)сервера(?!\w))[\s\S]{0,110}" | Warning | "Перестановка слов или дополнительный текст между ними"
703 r"(?!.*(?:\b(?:cpu|ram|gpu|ip|dns|fqdn|os|vcore|vcpu|hdd|ssd|volume|disk|size|role|type|owner|count|address|location|purpose|operating|system|description)\b|\b(?:роль|тип|адрес|количество|владелец|местоположение|назначение|описание|операционная|диск|диска|дисковая|объ[её]м|память|озу|ядра|ядер|процессор|процессора|размещение)\b))(?=[\s\S]*(?<!\w)Наименование(?!\w))(?=[\s\S]*(?<!\w)сервера(?!\w))[\s\S]{0,110}" | Warning | "Перестановка слов или дополнительный текст между ними"
